[Unit]
Description=Mneme optional library snapshot and relay

[Service]
Type=oneshot
# Set this service PATH for the reviewed installation; no interactive shell is run.
# env is located by systemd, then resolves Python through this PATH.
Environment=PATH=/home/user/.local/bin:/home/user/.nix-profile/bin:/etc/profiles/per-user/user/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=env python3 /ABSOLUTE/REPO/integrations/library/library.py --config /ABSOLUTE/library.json once
