# Example unit: replace account and paths with your reviewed installation.
[Unit]
Description=Private Signal bridge for Mneme workshop
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user
UMask=0077
# Set the service PATH explicitly; no interactive shell is run. env resolves
# Python and child tools through these maintained profiles, not a binary pin.
Environment=PATH=/home/user/.local/bin:/home/user/.nix-profile/bin:/etc/profiles/per-user/user/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=env python3 /home/user/.local/share/mneme/workshop/current/signal_bridge.py run --config /home/user/.local/share/mneme/signal/config/bridge.json
Restart=on-failure
RestartSec=20s
TimeoutStopSec=20s
KillMode=mixed
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
